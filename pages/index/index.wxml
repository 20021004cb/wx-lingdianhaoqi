    <image src="https://www.lingdianhaoqi.fun/img/food2.c329686e.jpg" style="width: 340rpx;margin-left: 20rpx;"></image>
  </view>
  <view>
    <image src="https://www.lingdianhaoqi.fun/img/people2.dc635893.jpg" style="width: 340rpx;"></image>
