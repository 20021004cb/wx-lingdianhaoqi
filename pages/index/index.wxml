  <video src="https://www.lingdianhaoqi.fun/media/video3.1cbe17c9.mp4"    show-center-play-btn='{{false}}' show-play-btn="{{true}}" controls picture-in-picture-mode="{{['push', 'pop']}}" bindenterpictureinpicture='bindVideoEnterPictureInPicture' bindleavepictureinpicture='bindVideoLeavePictureInPicture' class="show-video"></video>
</view>
